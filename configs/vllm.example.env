# Example vLLM server startup.
# Run inside the conda environment:
#
# conda activate vllm
# python -m vllm.entrypoints.openai.api_server --model Qwen/Qwen2.5-7B-Instruct --host 127.0.0.1 --port 8000
#
# Then call:
# vma "Plan, execute, and verify a research task." --backend vllm --model Qwen/Qwen2.5-7B-Instruct
